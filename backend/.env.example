# PostgreSQL bağlantısı — production'da MUTLAKA ayarlanmalı, default yoktur.
DATABASE_URL=postgresql://user:password@localhost:5432/liftup_db

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB=liftup_db

# Ollama (LLM)
OLLAMA_URL=http://127.0.0.1:11434

# CORS — virgülle ayrılmış izinli origin listesi (production frontend URL'i)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Yıkıcı/idari uçlar (reset, remove, reconcile, add) için API anahtarı.
# Ayarlanmazsa (yalnızca yerel geliştirme için) bu uçlar auth'suz kalır.
ADMIN_API_KEY=

# Yükleme/limit ayarları
MAX_UPLOAD_MB=30
RATE_LIMIT_PER_MINUTE=20

# Diskte PDF depolama dizini
PDF_STORAGE_DIR=storage/pdfs
