# PostgreSQL bağlantısı — production'da MUTLAKA ayarlanmalı, default yoktur.
DATABASE_URL=postgresql://user:password@localhost:5432/liftup_db

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB=liftup_db

# Embedding modeli — değiştirirseniz EMBEDDING_DIM'i de o modelin çıktı
# boyutuna göre güncelleyin VE scripts/reembed_all.py'yi çalıştırın (mevcut
# PDF'ler eski modelin vektörleriyle kayıtlı, yeni modelle karşılaştırılamaz).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
EMBEDDING_DIM=768

# OpenRouter (LLM) — https://openrouter.ai/keys üzerinden alınır.
# Boş bırakılırsa LLM özellikleri (öneri/RAG/chat) devre dışı kalır.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# CORS — virgülle ayrılmış izinli origin listesi (production frontend URL'i)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Yıkıcı/idari uçlar (reset, remove, reconcile, add) için opsiyonel servis
# API anahtarı (tarayıcı dışı/otomasyon çağrıları için) — asıl admin yetkisi
# artık ADMIN_EMAILS ile kayıt olan gerçek kullanıcı hesabındandır.
ADMIN_API_KEY=

# Kullanıcı oturumları (JWT) — ZORUNLUDUR, ayarlanmazsa backend başlamaz.
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080

# Bu e-postalarla kayıt olan hesap otomatik "admin" rolü alır (virgülle ayrılmış).
ADMIN_EMAILS=admin@example.com

# Oturum çerezi yerel http://localhost geliştirmede false kalmalı;
# production'da HTTPS arkasında true yapılmalı.
COOKIE_SECURE=false

# Yükleme/limit ayarları
MAX_UPLOAD_MB=30
RATE_LIMIT_PER_MINUTE=20

# Diskte PDF depolama dizini
PDF_STORAGE_DIR=storage/pdfs
