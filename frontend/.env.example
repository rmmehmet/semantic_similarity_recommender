# Backend API adresi — production'da mutlaka gerçek backend URL'i ile override edilmeli.
VITE_API_URL=http://localhost:8000

# Backend'de ADMIN_API_KEY ayarlandıysa buraya aynı değer yazılmalı,
# aksi halde add/remove/reset/reconcile istekleri 401 döner.
# UYARI: bu değer derlenen frontend bundle'ında görünür durumda olur,
# gerçek kullanıcı bazlı yetkilendirme sağlamaz.
VITE_ADMIN_API_KEY=
